# Connection string for the results database (Vercel Postgres / Neon).
# On Vercel this is set automatically when you connect the database to the
# project. For local dev, copy this file to .env.local and paste your string.
# Any of DATABASE_URL / POSTGRES_URL / POSTGRES_PRISMA_URL works.
DATABASE_URL="postgres://user:password@host.neon.tech/dbname?sslmode=require"
